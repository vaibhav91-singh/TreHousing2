Options -MultiViews
RewriteEngine On
RewriteBase /

# Ensure correct MIME Types for CSS, JS and Web fonts for Edge/Chrome
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Cache-Control "max-age=2592000, public"
</IfModule>

# Handle nested /admin/assets/ or any subpath asset requests
RewriteRule ^.*/assets/(.*)$ assets/$1 [QSA,L]

# Allow static assets directly
RewriteCond %{REQUEST_URI} ^/assets [NC,OR]
RewriteCond %{REQUEST_URI} ^/media [NC,OR]
RewriteCond %{REQUEST_URI} ^/static [NC]
RewriteRule ^ - [L]

# React SPA routing: redirect all page routes (including /admin) to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]
